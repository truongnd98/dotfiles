##############################################
#           PERFORMANCE OPTIMIZATIONS        #
##############################################

# Use smart-case for intuitive behavior without loss of speed
--smart-case

# # Disable result sorting (sorting slows down rg)
# --no-sort

# Show only the matching lines (faster and cleaner)
--no-heading
--line-number


##############################################
#       SKIP DIRECTORIES THAT SLOW SEARCH    #
##############################################

# Node / JS ecosystem
--glob=!node_modules/
--glob=!dist/
--glob=!build/
--glob=!coverage/
--glob=!public/
--glob=!storybook-static/

# Frontend bundles
--glob=!*.min.js
--glob=!*.bundle.js
--glob=!*.map

# TypeScript
--glob=!*.tsbuildinfo

# Go
# KHÔNG loại `pkg/` và `bin/`: trong layout Go chuẩn `pkg/` là source code
# (và `bin/` có thể là package path). Build output của Go đã nằm ngoài repo.
--glob=!*.test

# Rust
--glob=!target/

# OS & tooling garbage
--glob=!.git/
--glob=!.cache/
--glob=!*.log
--glob=!*.tmp
--glob=!*.swp
--glob=!*.bak
--glob=!*.DS_Store

##############################################
#     LANGUAGE-AWARE SPEED IMPROVEMENTS      #
##############################################

# Prefer literal where possible (regex is slower)
# (Note: Do not force literal here — use -F on demand)


##############################################
#       OPTIONAL: BETTER DEFAULT UX          #
##############################################

--colors=line:style:bold
--colors=match:fg:blue
--colors=path:fg:green
